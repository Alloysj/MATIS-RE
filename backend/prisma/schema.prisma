// Prisma schema for MATIS backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  INACTIVE
  @@map("user_status")
}

enum UserType {
  ADMIN
  STAFF
  USER
  @@map("user_type")
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
  @@map("vehicle_status")
}

enum InsuranceStatus {
  ACTIVE
  EXPIRED
  PENDING
  @@map("insurance_status")
}

enum RegistrationStatus {
  VALID
  EXPIRED
  PENDING
  @@map("registration_status")
}

enum RouteStatus {
  ACTIVE
  INACTIVE
  @@map("route_status")
}

enum LoanType {
  NORMAL
  EMERGENCY
  @@map("loan_type")
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  REPAID
  DEFAULTED
  @@map("loan_status")
}

enum TransactionType {
  DEPOSIT
  LOAN_REPAYMENT
  INSURANCE_PAYMENT
  OPERATIONS_FEE
  SALARY
  EXPENSE
  @@map("transaction_type")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  @@map("payment_status")
}

enum PaymentCategory {
  SAVINGS
  LOAN_REPAYMENT
  INSURANCE
  OPERATIONS
  @@map("payment_category")
}

enum SalaryStatus {
  PENDING
  PAID
  CANCELLED
  @@map("salary_status")
}

enum SalaryAdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  @@map("salary_advance_status")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  @@map("expense_status")
}

enum ContactMessageType {
  GENERAL
  MEMBERSHIP
  LOANS
  TECHNICAL
  PARTNERSHIP
  @@map("contact_message_type")
}

enum ExitRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  @@map("exit_request_status")
}

// ---------------- Core Identity & Access ----------------

model Role {
  id          String          @id @default(uuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  users       UserRole[]
  primaryUsers User[]         @relation("PrimaryRole")
  rolePermissions RolePermission[]
  staffProfileRoles StaffProfileRole[]
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  category    String?
  rolePermissions RolePermission[]
  @@map("permissions")
}

model RolePermission {
  role       Role      @relation(fields: [roleId], references: [id])
  roleId     String   @map("role_id")
  permission Permission @relation(fields: [permissionId], references: [id])
  permissionId String @map("permission_id")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")
  role   Role   @relation(fields: [roleId], references: [id])
  roleId String @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

model StaffProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  roles       StaffProfileRole[]
  @@map("staff_profiles")
}

model StaffProfileRole {
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  staffProfileId String       @map("staff_profile_id")
  role           Role         @relation(fields: [roleId], references: [id])
  roleId         String       @map("role_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@id([staffProfileId, roleId])
  @@map("staff_profile_roles")
}

model User {
  id                    String   @id @default(uuid())
  memberNumber          BigInt   @unique @default(dbgenerated("nextval('users_member_number_seq'::regclass)")) @map("member_number")
  firstName             String   @map("first_name")
  lastName              String   @map("last_name")
  email                 String   @unique
  phone                 String?
  passwordHash          String   @map("password_hash")
  userType              UserType @default(USER) @map("user_type")
  roleId                String?  @map("role_id")
  role                  Role?    @relation("PrimaryRole", fields: [roleId], references: [id])
  roles                 UserRole[]
  status                UserStatus @default(PENDING)
  membershipType        String?  @map("membership_type")
  profileCategory       String?  @map("profile_category")
  idNumber              String?  @map("id_number")
  dateOfBirth           DateTime? @map("date_of_birth")
  county                String?
  town                  String?
  address               String?
  businessName          String?  @map("business_name")
  businessType          String?  @map("business_type")
  shareCapital          Decimal? @default(0) @map("share_capital")
  savingsBalance        Decimal? @default(0) @map("savings_balance")
  loanBalance           Decimal? @default(0) @map("loan_balance")
  totalDeposits         Decimal? @default(0) @map("total_deposits")
  nextOfKin             String?  @map("next_of_kin")
  nextOfKinPhone        String?  @map("next_of_kin_phone")
  occupation            String?
  registrationDate      DateTime @default(now()) @map("registration_date")
  lastLogin             DateTime? @map("last_login")
  hasCompletedCapitalPayment Boolean @default(false) @map("has_completed_capital_payment")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime? @map("updated_at")
  vehicles             Vehicle[] @relation("OwnerVehicles")
  driverAssignments    Vehicle[] @relation("DriverVehicles")
  vehicleDriverAssignments VehicleDriverAssignment[] @relation("AssignmentsUser")
  loansApplied         Loan[]    @relation("LoanApplicant")
  loansApproved        Loan[]    @relation("LoanApprover")
  loanGuarantor        LoanGuarantor[]
  savingsAccounts      SavingsAccount[]
  payments             Payment[]
  paymentsDriver       Payment[] @relation("PaymentDriver")
  transactions         Transaction[]
  staffSalaries        StaffSalary[] @relation("SalaryStaff")
  salaryAdvances       SalaryAdvance[] @relation("AdvanceStaff")
  salaryAdvanceApprovals SalaryAdvance[] @relation("AdvanceApprover")
  expensesCreated      Expense[] @relation("ExpenseCreator")
  capitalPayments      CapitalPayment[]
  exitRequests         ExitRequest[]
  exitProcessed        ExitRequest[] @relation("ExitProcessor")
  @@map("users")
}

// ---------------- Fleet & Route Management ----------------

model Route {
  id              String        @id @default(uuid())
  name            String        @unique
  startPoint      String        @map("start_point")
  endPoint        String        @map("end_point")
  distanceKm      Decimal?      @map("distance_km")
  estimatedTime   Unsupported("interval")? @map("estimated_time")
  vehiclesAssigned Int?         @default(0) @map("vehicles_assigned")
  fare            Decimal?
  status          RouteStatus   @default(ACTIVE)
  dateCreated     DateTime      @default(now()) @map("date_created")
  vehicles        Vehicle[]
  payments        Payment[]
  @@map("routes")
}

model Vehicle {
  id                  String   @id @default(uuid())
  ownerId             String   @map("owner_id")
  owner               User     @relation("OwnerVehicles", fields: [ownerId], references: [id])
  plateNumber         String   @unique @map("plate_number")
  model               String?
  vehicleType         String?  @map("vehicle_type")
  capacity            Int?
  chassisNumber       String?  @map("chassis_number")
  engineNumber        String?  @map("engine_number")
  yearOfManufacture   Int?     @map("year_of_manufacture")
  routeId             String?  @map("route_id")
  route               Route?   @relation(fields: [routeId], references: [id])
  status              VehicleStatus @default(ACTIVE)
  driverId            String?  @map("driver_id")
  driver              User?    @relation("DriverVehicles", fields: [driverId], references: [id])
  insuranceStatus     InsuranceStatus @default(PENDING) @map("insurance_status")
  insuranceProvider   String?  @map("insurance_provider")
  policyType          String?  @map("policy_type")
  premium             Decimal?
  insuranceExpiry     DateTime? @map("insurance_expiry")
  registrationStatus  RegistrationStatus @default(PENDING) @map("registration_status")
  registrationExpiry  DateTime? @map("registration_expiry")
  dateAdded           DateTime @default(now()) @map("date_added")

  driverAssignments   VehicleDriverAssignment[]
  loans               Loan[]
  savingsAccounts     SavingsAccount[]
  payments            Payment[]
  transactions        Transaction[]
  insurancePolicies   InsurancePolicy[]
  @@map("vehicles")
}

model VehicleDriverAssignment {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId    String   @map("driver_id")
  driver      User     @relation("AssignmentsUser", fields: [driverId], references: [id])
  assignedAt  DateTime @default(now()) @map("assigned_at")
  releasedAt  DateTime? @map("released_at")
  @@map("vehicle_driver_assignments")
}

// ---------------- Financials ----------------

model Loan {
  id                    String   @id @default(uuid())
  applicantId           String   @map("applicant_id")
  applicant             User     @relation("LoanApplicant", fields: [applicantId], references: [id])
  vehicleId             String?  @map("vehicle_id")
  vehicle               Vehicle? @relation(fields: [vehicleId], references: [id])
  type                  LoanType
  amount                Decimal
  purpose               String?
  savingsAtApplication  Decimal? @map("savings_at_application")
  applicationDate       DateTime @default(now()) @map("application_date")
  status                LoanStatus @default(PENDING)
  creditScore           Int?     @map("credit_score")
  monthlyIncome         Decimal? @map("monthly_income")
  existingLoans         Decimal? @map("existing_loans")
  urgency               String?
  expectedRepaymentDate DateTime? @map("expected_repayment_date")
  approvedById          String?   @map("approved_by")
  approvedBy            User?    @relation("LoanApprover", fields: [approvedById], references: [id])
  approvedAt            DateTime? @map("approved_at")
  guarantors            LoanGuarantor[]
  @@map("loans")
}

model LoanGuarantor {
  id          String @id @default(uuid())
  loanId      String @map("loan_id")
  loan        Loan   @relation(fields: [loanId], references: [id])
  guarantorId String @map("guarantor_id")
  guarantor   User   @relation(fields: [guarantorId], references: [id])
  @@map("loan_guarantors")
}

model SavingsAccount {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id])
  vehicleId     String?  @map("vehicle_id")
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  accountType   String?  @map("account_type")
  balance       Decimal? @default(0)
  monthlyTarget Decimal? @map("monthly_target")
  lastDeposit   DateTime? @map("last_deposit")
  createdAt     DateTime @default(now()) @map("created_at")
  transactions  Transaction[]
  @@map("savings_accounts")
}

model MpesaStkRequest {
  id                 String   @id @default(uuid())
  checkoutRequestId  String   @unique @map("checkout_request_id")
  merchantRequestId  String?  @map("merchant_request_id")
  phone              String
  amount             Decimal
  status             String
  resultCode         Int?     @map("result_code")
  resultDesc         String?  @map("result_desc")
  mpesaReceiptNumber String?  @map("mpesa_receipt_number")
  userId             String?  @map("user_id")
  vehicleId          String?  @map("vehicle_id")
  paymentId          String?  @map("payment_id")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("mpesa_stk_requests")
}

model Payment {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id])
  vehicleId    String?  @map("vehicle_id")
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  driverId     String?  @map("driver_id")
  driver       User?    @relation("PaymentDriver", fields: [driverId], references: [id])
  routeId      String?  @map("route_id")
  route        Route?   @relation(fields: [routeId], references: [id])
  paymentDate  DateTime @default(now()) @map("payment_date")
  totalAmount  Decimal  @map("total_amount")
  mpesaReference String? @map("mpesa_reference")
  status       PaymentStatus @default(PENDING)
  allocations  PaymentAllocation[]
  transactions Transaction[]
  @@map("payments")
}

model PaymentAllocation {
  id         String @id @default(uuid())
  paymentId  String @map("payment_id")
  payment    Payment @relation(fields: [paymentId], references: [id])
  category   PaymentCategory
  amount     Decimal
  @@map("payment_allocations")
}

model Transaction {
  id            String   @id @default(uuid())
  accountId     String   @map("account_id")
  account       SavingsAccount @relation(fields: [accountId], references: [id])
  vehicleId     String? @map("vehicle_id")
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  userId        String? @map("user_id")
  user          User?    @relation(fields: [userId], references: [id])
  paymentId     String? @map("payment_id")
  payment       Payment? @relation(fields: [paymentId], references: [id])
  date          DateTime @default(now())
  type          TransactionType
  amount        Decimal
  balanceAfter  Decimal? @map("balance_after")
  description   String?
  @@map("transactions")
}

model InsurancePolicy {
  id            String @id @default(uuid())
  vehicleId     String @map("vehicle_id")
  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])
  provider      String?
  policyType    String?  @map("policy_type")
  premiumAmount Decimal? @map("premium_amount")
  startDate     DateTime? @map("start_date")
  expiryDate    DateTime? @map("expiry_date")
  status        InsuranceStatus @default(PENDING)
  @@map("insurance_policies")
}

// ---------------- Staff Operations & Expenses ----------------

model StaffSalary {
  id             String @id @default(uuid())
  staffId        String @map("staff_id")
  staff          User   @relation("SalaryStaff", fields: [staffId], references: [id])
  basicSalary    Decimal @map("basic_salary")
  allowances     Decimal?
  nhif           Decimal?
  nssf           Decimal?
  paye           Decimal?
  netSalary      Decimal @map("net_salary")
  bankName       String? @map("bank_name")
  accountNumber  String? @map("account_number")
  payDate        DateTime? @map("pay_date")
  status         SalaryStatus @default(PENDING)
  createdAt      DateTime @default(now()) @map("created_at")
  @@map("staff_salaries")
}

model SalaryAdvance {
  id             String @id @default(uuid())
  staffId        String @map("staff_id")
  staff          User   @relation("AdvanceStaff", fields: [staffId], references: [id])
  amount         Decimal
  reason         String?
  applicationDate DateTime @default(now()) @map("application_date")
  status         SalaryAdvanceStatus @default(PENDING)
  approvedById   String? @map("approved_by")
  approvedBy     User?  @relation("AdvanceApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime? @map("approved_at")
  @@map("salary_advances")
}

model Expense {
  id          String @id @default(uuid())
  category    String?
  description String?
  amount      Decimal
  date        DateTime @default(now())
  status      ExpenseStatus @default(PENDING)
  vendor      String?
  createdById String? @map("created_by")
  createdBy   User?  @relation("ExpenseCreator", fields: [createdById], references: [id])
  @@map("expenses")
}

// ---------------- Membership & Communication ----------------

model CapitalPayment {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  user           User    @relation(fields: [userId], references: [id])
  amount         Decimal
  phoneNumber    String? @map("phone_number")
  mpesaReference String? @map("mpesa_reference")
  paymentDate    DateTime @default(now()) @map("payment_date")
  status         PaymentStatus @default(PENDING)

  @@map("capital_payments")
}

model ExitRequest {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  user           User   @relation(fields: [userId], references: [id])
  email          String
  reason         String?
  additionalComments String? @map("additional_comments")
  netAmount      Decimal? @map("net_amount")
  requestDate    DateTime @default(now()) @map("request_date")
  status         ExitRequestStatus @default(PENDING)
  processedById  String? @map("processed_by")
  processedBy    User? @relation("ExitProcessor", fields: [processedById], references: [id])
  processedAt    DateTime? @map("processed_at")
  @@map("exit_requests")
}

model ContactMessage {
  id        String @id @default(uuid())
  name      String?
  email     String?
  phone     String?
  subject   String?
  message   String?
  type      ContactMessageType
  createdAt DateTime @default(now()) @map("created_at")
  @@map("contact_messages")
}
